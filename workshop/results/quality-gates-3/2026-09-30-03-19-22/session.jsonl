{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015o9JmY7ZgmaH5Br7rbR54F","type":"tool_result","content":"1\timport java.nio.charset.StandardCharsets\n2\timport java.nio.file.{FileSystems, Files, Path, Paths}\n3\timport java.util.regex.Pattern\n4\timport scala.jdk.CollectionConverters.*\n5\t\n6\tobject SpecCheck:\n7\t  private val Heading: Pattern = Pattern.compile(\n8\t    \"\"\"^## M[0-9]+([A-Za-z][A-Za-z0-9_-]*)?: .+ \\(Status: (PENDING|IMPLEMENTING|IMPLEMENTED|PARTIALLY_DONE|SKIPPED|POSTPONED|✅ DONE)\\)$\"\"\"\n9\t  )\n10\t  private val Ac = \"**Acceptance Criteria:**\"\n11\t  private val Details = \"**Implementation Details:**\"\n12\t  private val Forbidden: Pattern = Pattern.compile(\"\"\"^### (Implementation Details\\b|M)\"\"\")\n13\t  private val Checkbox: Pattern = Pattern.compile(\"\"\"^- \\[[ x]\\] .+$\"\"\")\n14\t  private val CheckedStatus = Set(\"(Status: IMPLEMENTED)\", \"(Status: ✅ DONE)\")\n15\t  private val SpecName = FileSystems.getDefault.getPathMatcher(\"glob:SPEC.*.md\")\n16\t\n17\t  def main(args: Array[String]): Unit =\n18\t    if args.length != 1 then sys.exit(1)\n19\t    val raw = args(0)\n20\t    val path = Paths.get(raw)\n21\t    if !Files.exists(path) then\n22\t      System.err.println(s\"$raw:1\")\n23\t      sys.exit(1)\n24\t    if Files.isRegularFile(path) then\n25\t      checkFile(raw, path) match\n26\t        case Some(report) =>\n27\t          System.err.println(report)\n28\t          sys.exit(1)\n29\t        case None =>\n30\t          sys.exit(0)\n31\t    if Files.isDirectory(path) then\n32\t      val files =\n33\t        Files.list(path).iterator().asScala.filter(Files.isRegularFile(_)).toSeq.sortBy(_.getFileName.toString)\n34\t      if files.isEmpty then\n35\t        System.err.println(s\"$raw:1\")\n36\t        sys.exit(1)\n37\t      val reports = files.flatMap { child =>\n38\t        val display =\n39\t          if raw.endsWith(\"/\") || raw.endsWith(java.io.File.separator) then raw + child.getFileName.toString\n40\t          else raw + java.io.File.separator + child.getFileName.toString\n41\t        checkFile(display, child)\n42\t      }\n43\t      if reports.nonEmpty then\n44\t        System.err.println(reports.mkString(\"\\n\"))\n45\t        sys.exit(1)\n46\t      sys.exit(0)\n47\t    System.err.println(s\"$raw:1\")\n48\t    sys.exit(1)\n49\t\n50\t  private def nameOk(name: String): Boolean =\n51\t    SpecName.matches(Paths.get(name))\n52\t\n53\t  private def checkFile(display: String, path: Path): Option[String] =\n54\t    if !nameOk(path.getFileName.toString) then return Some(s\"$display:1\")\n55\t    val text =\n56\t      try Files.readString(path, StandardCharsets.UTF_8)\n57\t      catch case _: Exception => return Some(s\"$display:1\")\n58\t    firstViolation(text.linesIterator.toSeq).map(line => s\"$display:$line\")\n59\t\n60\t  private def firstViolation(lines: Seq[String]): Option[Int] =\n61\t    var index = 0\n62\t    while index < lines.length do\n63\t      val line = lines(index)\n64\t      if !line.startsWith(\"## M\") then index += 1\n65\t      else\n66\t        var end = index + 1\n67\t        while end < lines.length && !lines(end).startsWith(\"## \") do end += 1\n68\t        val body = lines.slice(index + 1, end)\n69\t        val owns = body.contains(Ac) || body.exists(_.startsWith(\"**Acceptance\"))\n70\t        if owns && !Heading.matcher(line).matches() then return Some(index + 1)\n71\t        var offset = 0\n72\t        while offset < body.length do\n73\t          val item = body(offset)\n74\t          val lineNo = index + 2 + offset\n75\t          if item.startsWith(\"**Acceptance\") && item != Ac then return Some(lineNo)\n76\t          if Forbidden.matcher(item).lookingAt() then return Some(lineNo)\n77\t          offset += 1\n78\t        subsectionViolation(body, index + 2) match\n79\t          case Some(v) => return Some(v)\n80\t          case None =>\n81\t            if Heading.matcher(line).matches() && !body.contains(Ac) then return Some(index + 1)\n82\t            if Heading.matcher(line).matches() then\n83\t              boxViolation(line, body, index + 2) match\n84\t                case Some(v) => return Some(v)\n85\t                case None    => ()\n86\t        index = end\n87\t    None\n88\t\n89\t  private def subsectionViolation(body: Seq[String], startLine: Int): Option[Int] =\n90\t    val criteria = scala.collection.mutable.ArrayBuffer.empty[Int]\n91\t    val details = scala.collection.mutable.ArrayBuffer.empty[Int]\n92\t    var offset = 0\n93\t    while offset < body.length do\n94\t      val item = body(offset)\n95\t      val lineNo = startLine + offset\n96\t      if item.startsWith(Details) && item != Details then return Some(lineNo)\n97\t      if item == Ac then criteria += lineNo\n98\t      else if item == Details then details += lineNo\n99\t      offset += 1\n100\t    if criteria.length > 1 then return Some(criteria(1))\n101\t    if details.length > 1 then return Some(details(1))\n102\t    if details.nonEmpty && (criteria.isEmpty || details(0) < criteria(0)) then return Some(details(0))\n103\t    None\n104\t\n105\t  private def boxViolation(heading: String, body: Seq[String], startLine: Int): Option[Int] =\n106\t    val start = body.indexOf(Ac) + 1\n107\t    val end =\n108\t      body.indices\n109\t        .find(i => i >= start && body(i) == Details)\n110\t        .getOrElse(body.length)\n111\t    val status = heading.substring(heading.lastIndexOf(\"(Status: \"))\n112\t    val partial = status == \"(Status: PARTIALLY_DONE)\"\n113\t    val checked = CheckedStatus.contains(status)\n114\t    var index = start\n115\t    while index < end do\n116\t      val item = body(index)\n117\t      if item != \"\" then\n118\t        if !Checkbox.matcher(item).matches() then return Some(startLine + index)\n119\t        if !partial && item.startsWith(\"- [x] \") != checked then return Some(startLine + index)\n120\t      index += 1\n121\t    None\n122\t"}]},"parent_tool_use_id":null,"session_id":"c10