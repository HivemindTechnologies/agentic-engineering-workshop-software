#!/usr/bin/env bash
# Free the serve port (default 8000, or $PORT).
set -euo pipefail

PORT="${PORT:-8000}"
PIDS="$(lsof -ti "tcp:${PORT}" 2>/dev/null || true)"

if [[ -z "$PIDS" ]]; then
  echo "nothing listening on port ${PORT}"
  exit 0
fi

echo "stopping $(echo "$PIDS" | tr '\n' ' ')on port ${PORT}"
kill $PIDS 2>/dev/null || true
