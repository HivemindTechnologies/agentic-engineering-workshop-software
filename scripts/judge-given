#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import journey

COPIES = (
    "refine-1a",
    "refine-4",
    "refine-5",
    "refine-6",
    "implement-1",
    "implement-1b",
    "implement-2",
    "quality-gates-1",
    "refine-7",
    "quality-gates-2",
    "skills-1",
    "skills-2",
    "quality-gates-3",
    "quality-gates-4",
)


def files_for(material, lesson):
    order = journey.order_path(journey.journey_beside_material(material))
    if lesson not in order:
        raise SystemExit(f"unknown lesson: {lesson}")
    found = {}
    take(Path(material) / "00-base", found)
    for name in order:
        if name in COPIES:
            take(Path(material) / name, found)
        if name == lesson:
            break
    return found


def take(directory, found):
    if not directory.is_dir():
        return
    for path in sorted(item for item in directory.rglob("*") if item.is_file()):
        found[path.relative_to(directory).as_posix()] = path.read_text()


def fence_for(text):
    longest = 0
    run = 0
    for char in text:
        if char == "`":
            run += 1
            longest = max(longest, run)
        else:
            run = 0
    return "`" * max(3, longest + 1)


def render(found):
    parts = ["# Given to the participant", ""]
    for rel in sorted(found):
        text = found[rel].rstrip("\n")
        fence = fence_for(text)
        parts.extend([f"## {rel}", fence, text, fence, ""])
    return "\n".join(parts).rstrip("\n") + "\n"


def main(argv):
    paths_only = False
    args = []
    for token in argv:
        if token == "--paths":
            paths_only = True
        else:
            args.append(token)
    if len(args) != 2:
        raise SystemExit("usage: judge-given <material> <lesson> [--paths]")
    found = files_for(Path(args[0]), args[1])
    if paths_only:
        print("\n".join(sorted(found)))
        return
    sys.stdout.write(render(found))


if __name__ == "__main__":
    main(sys.argv[1:])
